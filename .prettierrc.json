{
  "printWidth": 120,
  "tabWidth": 2,
  "semi": true,
  "trailingComma": "all",
  "singleQuote": false,
  "plugins": ["@trivago/prettier-plugin-sort-imports"],
  "importOrder": [
    "^react$",
    "^react-dom$",
    "^react-.*$",
    "^next$",
    "^next/.*$",
    "^@tanstack/.*$",
    "^@radix-ui/.*$",
    "^@prisma/client$",
    "^zod$",
    "^axios$",
    "^express$",
    "^@ecs-go/.*$",
    "^@(?!/)",
    "^[^.]",
    "^[./](?!.*\\.css$).*$",
    ".*\\.css$"
  ],
  "importOrderSeparation": true,
  "importOrderSortSpecifiers": true,
  "importOrderCaseInsensitive": true,
  "importOrderParserPlugins": ["typescript", "jsx", "decorators-legacy"]
}
